# Dynasty environment example — placeholders only. Copy to .env.local for local development.
# Never commit .env.local, production secrets, service-role keys, database passwords, or real tokens.

# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session/cookie signing secret. Server-only. REQUIRED in production (the app refuses to sign
# sessions without it there, rather than using a per-process secret).
DYNASTY_APP_SECRET=replace-with-at-least-32-random-bytes

# Client identity for rate limits. REQUIRED in production: declare exactly ONE of these.
# Forwarding headers are never trusted by default, because a client can write them.
#   DYNASTY_TRUSTED_PROXY_HOPS = how many proxies sit in front of the app, each appending to
#     X-Forwarded-For. The client is the entry that many places from the right.
#   DYNASTY_CLIENT_IP_HEADER   = one header that ONLY the platform sets (e.g. cf-connecting-ip).
# DYNASTY_TRUSTED_PROXY_HOPS=1
# DYNASTY_CLIENT_IP_HEADER=cf-connecting-ip

# Persistence driver selection:
#   postgres = production Supabase/PostgreSQL target
#   sqlite   = local development/sandbox/test only
# Omit locally to default to sqlite when DATABASE_URL is absent.
DYNASTY_DB_DRIVER=sqlite
DYNASTY_SQLITE_PATH=.data/dynasty-dev.sqlite

# Production PostgreSQL/Supabase. Server-only. REQUIRED for production persistence.
# Use the pooled Supabase/Postgres connection string provided by your deployment secrets manager.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Alternative names supported by the app:
# POSTGRES_URL=
# SUPABASE_DB_URL=

# Supabase client configuration. NEXT_PUBLIC_* values are browser-visible by design;
# use the publishable/anon key only, never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
# NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-placeholder

# Supabase service role. SERVER-ONLY. Do not expose to client code.
SUPABASE_SERVICE_ROLE_KEY=service-role-placeholder-do-not-commit-real-value

# Local maintenance guard for `npm run db:reset`.
# DYNASTY_RESET_DEV_DB=yes
